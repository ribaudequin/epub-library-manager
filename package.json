{
  "name": "epub-shelf",
  "productName": "EPUB Shelf",
  "version": "1.8.3",
  "description": "EPUB library manager organized by series",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage",
    "dist:deb": "electron-builder --linux deb",
    "dist:rpm": "electron-builder --linux rpm",
    "dist:flatpak": "electron-builder --linux dir",
    "dist:win": "electron-builder --win nsis",
    "dist:win:portable": "electron-builder --win portable",
    "dist:win:all": "electron-builder --win",
    "dist:all": "electron-builder --linux AppImage --win",
    "test": "node test/validate-modules.js"
  },
  "author": "Marcelo Salvador",
  "license": "MIT",
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "io.github.ribaudequin.epub-library-manager",
    "productName": "BibliotecaEpub",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "files": [
      "src/**/*",
      "package.json"
    ]
  }
}
