{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeBuildCommand": "npm ci || exit 0",
    "devPath": "src",
    "distDir": "../dist"
  },
  "productName": "EPUB Shelf",
  "version": "1.9.8",
  "identifier": "io.github.ribaudequin.epub-library-manager",
  "app": {
    "windows": [
      {
        "title": "EPUB Shelf",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "category": "Office",
    "copyright": "MIT",
    "linux": {
      "deb": {
        "depends": []
      },
      "icon": ["icons/icon.png"]
    },
    "macOS": {
      "exceptionDomain": ""
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": null
    }
  }
}
