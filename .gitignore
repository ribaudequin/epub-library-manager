node_modules/
dist/
*.img
.agents/
promps/

# Memory, planning and agent notes are the user's working context: local-only,
# never committed. The `*.md` rule further down already covers them, but they
# are named explicitly because a pattern cannot untrack a file Git already
# tracks — MEMORY-ARCHIVE.md, PLAN.md and PLAN-LIGHT-THEME-STATS.md stayed
# tracked after commit ccd4db6 and had to be cleaned up with `git rm --cached`.
# Their only backup is .memory-snapshots/, which is gitignored too.
MEMORY.md
MEMORY-ARCHIVE.md
TODO.md
PLAN.md
PLAN-*.md
PLANO.md
AGENTS.md

# Dated snapshots of the local-only memory files (scripts/snapshot-memory.sh).
# These are copies of gitignored working notes and must not be committed.
.memory-snapshots/

# The scanned library used for testing. Local only: it holds the user's own
# EPUBs, which must never reach GitHub. test/generate-test-library.js rebuilds
# the fixture when test-cache.js needs one.
test/test-library/

# Chromium/Electron caches written by a test run. Machine-local state, never
# source. The test scripts create their own user-data dirs under the tmp dir.
test/test-userdata-*/
test/ud-test*/
test/screenshot-out/

squashfs-root/
*.png.bak
tint*.png
screen*.png
real*.png
*.tar.gz
/flathub/build/
target/
tauri-app/src-tauri/gen/
# flatpak-builder's own state and build directories, created by a local build.
.flatpak-builder/
build-dir/
repo/
*.flatpak
*.md
!README*.md
!docs/**/*.md
